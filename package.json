{
  "name": "dsh-web-search-pro-plus",
  "version": "0.2.1-r1",
  "description": "Enhanced, persistent web search plugin for DeepSeek Harness, adapted to dsh 0.2.1-rc.2 — multi-engine routing, SQLite+LRU cache, readable extraction, and evidence packs.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "catalog",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LOGIN.md",
    "scripts",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/isolate-path.mjs --test --experimental-transform-types test/*.test.ts",
    "test:client-bundle": "node scripts/check-client-bundle.mjs",
    "verify": "pnpm run typecheck && pnpm run test:peers && pnpm run build && pnpm test && pnpm run test:client-bundle",
    "prepublishOnly": "pnpm run verify",
    "test:peers": "node test/compat/check-peer-ranges.js",
    "bench:typecheck": "tsc -p bench/tsconfig.json",
    "bench:test": "node --test --experimental-transform-types bench/test/*.test.ts",
    "bench:harvest": "node --experimental-transform-types bench/src/harvest.ts",
    "bench:label": "node --experimental-transform-types bench/src/label-llm.ts",
    "bench:judges": "node --experimental-transform-types bench/src/run-judges.ts",
    "bench:report": "node --experimental-transform-types bench/src/report.ts",
    "bench:eval-gate": "node --experimental-transform-types bench/src/eval-gate.ts",
    "bench:eval-pack": "node --experimental-transform-types bench/src/eval-pack.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "js-yaml": "^4.3.2",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@anweat/dsh-browser": "0.2.0",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cosmokit": "~1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertZJ/dsh-web-search-pro-plus.git"
  },
  "homepage": "https://github.com/AlbertZJ/dsh-web-search-pro-plus#readme",
  "bugs": {
    "url": "https://github.com/AlbertZJ/dsh-web-search-pro-plus/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-search",
    "search"
  ]
}
